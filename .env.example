# npm start and npm run dev load this file when copied to .env.
# Docker Compose also reads .env for its interpolation values.
# Do not commit .env or place provider keys here; use Connections in Tupies.
STUDIO_PORT=4310
STUDIO_DATA_DIR=./data
# Native local default is 127.0.0.1. The Compose file binds 0.0.0.0 inside its container.
STUDIO_HOST=127.0.0.1
# Set only when deploying behind a trusted HTTPS reverse proxy.
# STUDIO_PUBLIC_URL=https://studio.example.com
# Name shown to apps and linked engines (rename later in Devices & sync).
# STUDIO_ENGINE_NAME=Home server
# Extra host names allowed to reach this engine directly, comma separated (e.g. a Tailscale IP).
# STUDIO_ALLOWED_HOSTS=100.101.102.103
# engine: serve HTTPS directly with this engine's identity key; apps trust it through the pairing QR code (no domain).
# STUDIO_TLS=engine
# Which proxies may report the client address in X-Forwarded-For: loopback (default), private (containers) or none.
# STUDIO_TRUSTED_PROXY=loopback
# Only for a trusted private network: allow plain-HTTP pairing and engine links to non-loopback hosts.
# STUDIO_SYNC_ALLOW_HTTP=true
# Where a loopback engine writes the Mac app's same-user pairing file (macOS default shown).
# STUDIO_LOCAL_PAIRING_FILE="$HOME/Library/Application Support/Hermes Studio/local-engine.json"
# STUDIO_SECURE_COOKIE=true
# Opt in only for deliberately selected trusted private model/API services.
# Public HTTP and metadata/link-local destinations remain blocked.
# STUDIO_ALLOW_PRIVATE_HTTP=true
# Local open-source/self-hosted ChatGPT plan registration is the default.
# Paid/remotely hosted products require OpenAI onboarding and an approved client.
STUDIO_DEPLOYMENT_MODE=local
# STUDIO_OPENAI_CLIENT_ID=<operator-approved-client-id>

# Optional native iPhone push delivery. Configure only on the home server (or a standalone engine).
# Keep the downloaded Apple .p8 key outside bot workspaces and release archives, readable only by the engine account.
# STUDIO_APNS_KEY_FILE=/private/operator/path/AuthKey.p8
# STUDIO_APNS_KEY_ID=YOURKEYID1
# STUDIO_APNS_TEAM_ID=YOURTEAMID
# STUDIO_APNS_TOPIC=dev.hermesstudio.app
# sandbox for development-signed iPhone builds; production for TestFlight/App Store builds.
# STUDIO_APNS_ENVIRONMENT=sandbox
