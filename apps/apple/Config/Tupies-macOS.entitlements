<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>keychain-access-groups</key>
    <array><string>$(AppIdentifierPrefix)dev.tupies.app</string></array>
	<!-- Not sandboxed: the Mac app launches a local `node` engine and reads its discovery file. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime: allow the web UI's voice features to use the microphone. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
