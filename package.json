{
  "name": "tupies",
  "version": "0.5.0",
  "private": true,
  "description": "Self-hosted AI bot teammates with their own engine, shared memory, rich chat, real documents and bounded collaboration.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "pair": "node --env-file-if-exists=.env scripts/pair.mjs",
    "context:report": "node --env-file-if-exists=.env scripts/context-report.mjs",
    "eval:agent": "node scripts/eval-agent.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "runtime:backup": "node scripts/runtime-backup.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "docs:build": "node scripts/build-guide.mjs",
    "avatars:build": "node scripts/build-roki-assets.mjs && node scripts/build-companion-assets.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "licenses:build": "node scripts/collect-licenses.mjs",
    "build": "npm run brand:build && npm run avatars:build && npm run assets:build && npm run docs:build && npm run licenses:build",
    "brand:build": "node scripts/build-brand-assets.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "chart.js": "4.6.1",
    "docx": "9.14.0",
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "mammoth": "1.13.0",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "pptxgenjs": "4.0.1",
    "qrcode-generator": "2.0.4",
    "sharp": "0.35.5",
    "svg-to-pdfkit": "0.1.8",
    "typescript": "6.0.3",
    "typescript-language-server": "5.3.0",
    "unpdf": "1.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  }
}
