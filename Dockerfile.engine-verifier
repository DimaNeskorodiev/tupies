# Build only from a reviewed clean source checkout, never a live runtime directory.
# This image is provisioned by the operator; candidate jobs never build/pull/install.
FROM node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
RUN apt-get update && apt-get install -y --no-install-recommends python3 bash git ca-certificates chromium procps && rm -rf /var/lib/apt/lists/*
RUN useradd --uid 10001 --user-group --home-dir /tmp/verifier-home --no-create-home --shell /usr/sbin/nologin verifier
WORKDIR /opt/tupies-source
COPY package.json package-lock.json ./
RUN npm ci
COPY server.mjs README.md LICENSE AGENTS.md PROJECT_CONTEXT.md ./
COPY lib ./lib
COPY test ./test
COPY scripts ./scripts
COPY eval ./eval
COPY public ./public
COPY assets ./assets
COPY docs ./docs
RUN mkdir -p /opt/tupies-verifier && cp scripts/engine-verifier-runner.mjs /opt/tupies-verifier/runner.mjs && chmod -R a+rX /opt/tupies-source /opt/tupies-verifier
LABEL dev.tupies.engine-verifier="1"
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/node", "/opt/tupies-verifier/runner.mjs"]
